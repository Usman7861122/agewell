---
import InfoPage from '../components/sections/InfoPage.astro';
import type { Img, Block } from '../lib/info-types';
import { site } from '../lib/site';

// Fresh Unsplash photos (free licence), used only on this page. Saved in /public/images/pages.
const hero = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, srcset: `/images/pages/${n}-640.jpg 640w, /images/pages/${n}.jpg 1400w`, alt, w, h });
const body = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, alt, w, h });
const blocks: Block[] = [
  { type: 'contact', eyebrow: 'Get in touch', heading: 'We would love to hear from you', text: 'Send us a message or call our office. Tell us a little about what you are looking for and we will guide you to the right first step.', image: body('contact-body', 'A smiling woman on a sofa talking on the phone with a laptop on her lap', 1400, 788) },
  { type: 'cards', eyebrow: 'Good to know', heading: 'Before you visit', tone: 'white', items: [
    { title: 'Find us', body: site.address.street + ', ' + site.address.city + ', ' + site.address.region + ' ' + site.address.zip + '.' },
    { title: 'Hours', body: site.hours + '.' },
    { title: 'New here?', body: 'Read what to expect at your first visit.', href: '/resources/new-patients' },
  ] },
];
// TODO: practice to confirm hours and the form endpoint.
---
<InfoPage slug="contact" name="Contact" title="Contact Us" eyebrow="Contact · Bedminster, NJ" interest="not-sure"
  seoTitle="Contact Us | AgeWell Medicine & Aesthetics, Bedminster NJ"
  seoDescription="Contact AgeWell Medicine & Aesthetics at 2436 Lamington Rd, Bedminster, NJ. Call (908) 458-6874 or send a message."
  intro="Call, email or send a message. Our friendly team is here to help."
  heroImage={hero('contact-hero', 'A smiling receptionist working at a desk in a bright office', 1400, 933)} heroChip="We are here to help"
  blocks={blocks} medical={false} />
