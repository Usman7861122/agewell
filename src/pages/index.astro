---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Pillars from '../components/sections/Pillars.astro';
import Services from '../components/sections/Services.astro';
import HowCareWorks from '../components/sections/HowCareWorks.astro';
import VirtualVisits from '../components/sections/VirtualVisits.astro';
import Gallery from '../components/sections/Gallery.astro';
import Team from '../components/sections/Team.astro';
import HairRestoration from '../components/sections/HairRestoration.astro';
import Aesthetics from '../components/sections/Aesthetics.astro';
import Decades from '../components/sections/Decades.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Faq from '../components/sections/Faq.astro';
import Contact from '../components/sections/Contact.astro';
import { site } from '../lib/site';

// Structured data uses only confirmed practice details. No ratings or credentials are invented.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  name: site.name,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  address: { '@type': 'PostalAddress', streetAddress: site.address.street, addressLocality: site.address.city, addressRegion: site.address.region, postalCode: site.address.zip, addressCountry: 'US' },
};
---
<BaseLayout
  title="Longevity Medicine in Bedminster NJ | AgeWell"
  description="Explore physician-led longevity medicine, hormone care, medical weight management, non-surgical hair restoration and aesthetics in Bedminster NJ."
  schema={schema}>
  <Hero />
  <About />
  <Pillars />
  <Services />
  <HowCareWorks />
  <VirtualVisits />
  <Team />
  <Gallery />
  <HairRestoration />
  <Aesthetics />
  <Decades />
  <Testimonials />
  <Faq />
  <Contact />
</BaseLayout>
