---
import InfoPage from '../components/sections/InfoPage.astro';
import type { Img, Block } from '../lib/info-types';
import { site } from '../lib/site';

// Fresh Unsplash photos (free licence), used only on this page. Saved in /public/images/pages.
const hero = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, srcset: `/images/pages/${n}-640.jpg 640w, /images/pages/${n}.jpg 1400w`, alt, w, h });
const body = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, alt, w, h });
const g = 'https://www.google.com/maps/search/AgeWell+Medicine+%26+Aesthetics+Bedminster+NJ';
const blocks: Block[] = [
  { type: 'reviews', eyebrow: 'Patient reviews', heading: 'What our patients say', score: '5.0', count: 35, googleUrl: g, items: [
    { quote: 'I had a fantastic experience at the Agewell medicine spa! Tara is gentle, knowledgeable, and truly cares about achieving natural results. She enhanced my features perfectly without overdoing it. Highly recommend!', name: 'Diana Ramirez', when: '3 months ago' },
    { quote: 'Tara is very knowledge and thorough! After her first treatment, I noticed a substantial improvement in my energy levels and overall well-being. She even made me overcome my fear of needles and took the time to fill up each one! I cannot recommend her and her services enough.', name: 'Robert Nencheck', when: '11 months ago' },
    { quote: 'Tara is AMAZING! She takes time to listen and then devises a plan that’s just right for you. I am feeling so much better than I did only one month ago! I am overwhelmed by how good I now feel. I highly recommend visiting Tara at AgeWell Medicine & Aesthetics. You won’t be disappointed.', name: 'Stacy Guzman', when: 'a year ago' },
  ] },
  { type: 'band', heading: 'Share your experience', text: 'Seen us before? A Google review helps other patients find the right care.', primary: { label: 'Leave a Review', href: g } },
];
// TODO: confirm the practice may display these reviewer names and text. Replace with a live Google reviews feed when available.
---
<InfoPage slug="reviews" name="Reviews" title="Patient Reviews" eyebrow="Reviews · Bedminster, NJ" interest="not-sure"
  seoTitle="Patient Reviews | AgeWell Medicine & Aesthetics, Bedminster NJ"
  seoDescription="Read what patients say about AgeWell Medicine & Aesthetics in Bedminster, NJ. Rated 5.0 from 35 Google reviews."
  intro="Real words from patients, taken from our public Google reviews."
  heroImage={hero('reviews-hero', 'A happy older couple smiling together on a sofa', 1400, 788)} heroChip="5.0 on Google"
  blocks={blocks} medical={false} />
