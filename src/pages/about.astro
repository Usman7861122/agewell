---
import InfoPage from '../components/sections/InfoPage.astro';
import type { Img, Block } from '../lib/info-types';
import { site } from '../lib/site';

// Fresh Unsplash photos (free licence), used only on this page. Saved in /public/images/pages.
const hero = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, srcset: `/images/pages/${n}-640.jpg 640w, /images/pages/${n}.jpg 1400w`, alt, w, h });
const body = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, alt, w, h });
const blocks: Block[] = [
  { type: 'split', eyebrow: 'Our story', heading: 'More healthy years, planned with you', paragraphs: ['AgeWell Medicine & Aesthetics is a physician-led practice in Bedminster, NJ. It was co-founded by Dr. Frank Dos Santos and Tara Hibbett.', 'We bring longevity medicine, hair restoration and aesthetic care together in one personal approach to healthy aging.'], image: body('about-body', 'A smiling older couple standing near a tree outdoors', 1400, 933), bullets: ['Physician-led care', 'Listening before planning', 'Honest, clear explanations'], cta: { label: 'Meet Providers', href: '/providers' } },
  { type: 'cards', eyebrow: 'What we do', heading: 'Three lines of care', items: [
    { title: 'Longevity Medicine', body: 'Evaluation, metabolic health, hormone care and functional medicine.', href: '/longevity' },
    { title: 'Hair Restoration', body: 'Non-surgical hair restoration in partnership with GetHairMD.', href: '/hair-restoration' },
    { title: 'Aesthetics', body: 'Personalized care for expression lines, facial volume and skin quality.', href: '/aesthetics' },
  ] },
  { type: 'band', heading: 'Come and say hello.', text: 'We are at ' + site.address.street + ', ' + site.address.city + ', ' + site.address.region + '.', primary: { label: 'Request Consultation', href: '/#consultation' }, secondary: { label: 'Contact', href: '/contact' } },
];
---
<InfoPage slug="about" name="About" title="About AgeWell" eyebrow="About us · Bedminster, NJ" interest="not-sure"
  seoTitle="About Us | AgeWell Medicine & Aesthetics, Bedminster NJ"
  seoDescription="AgeWell Medicine & Aesthetics is a physician-led practice in Bedminster, NJ offering longevity medicine, hair restoration and aesthetics."
  intro="A physician-led practice for healthy aging, in the heart of Somerset County."
  heroImage={hero('about-hero', 'An older couple dancing and smiling at each other', 1400, 933)} heroChip="Physician-led"
  blocks={blocks} />
