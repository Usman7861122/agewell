const heroImage: ServiceImage = { src: '/images/aesthetics/botox-hero.jpg', srcset: '/images/aesthetics/botox-hero-640.jpg 640w, /images/aesthetics/botox-hero.jpg 1400w', alt: "A smiling older woman with short dark hair and a warm expression", w: 1400, h: 886 };
const images: [ServiceImage, ServiceImage, ServiceImage] = [
  { src: '/images/aesthetics/botox-a.jpg', alt: "A close-up of an older woman's face showing natural fine lines", w: 1400, h: 2489 },
  { src: '/images/aesthetics/botox-b.jpg', alt: "A patient resting with closed eyes during a facial treatment while a clinician works with fine instruments", w: 1400, h: 931 },
