---
import InfoPage from '../../components/sections/InfoPage.astro';
import type { Img, Block } from '../../lib/info-types';
import { site } from '../../lib/site';

// Fresh Unsplash photos (free licence), used only on this page. Saved in /public/images/pages.
const hero = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, srcset: `/images/pages/${n}-640.jpg 640w, /images/pages/${n}.jpg 1400w`, alt, w, h });
const body = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, alt, w, h });
const blocks: Block[] = [
  { type: 'cards', eyebrow: 'Coming soon', heading: 'Topics we are writing about', intro: 'Plain-language articles from our team. Check back soon.', items: [
    { title: 'What is healthspan?', body: 'Why living well matters as much as living long.', tag: 'Longevity' },
    { title: 'Understanding hormone changes', body: 'Common symptoms and when to talk with a clinician.', tag: 'Hormone care' },
    { title: 'Botox and Dysport', body: 'How they differ and what to ask at a consultation.', tag: 'Aesthetics' },
    { title: 'Hair thinning basics', body: 'Common causes and non-surgical options to discuss.', tag: 'Hair' },
    { title: 'A simple skincare routine', body: 'Fewer steps, chosen with your provider.', tag: 'Skincare' },
    { title: 'Getting ready for your first visit', body: 'What to bring and what to ask.', tag: 'Patients' },
  ] },
  { type: 'band', heading: 'Have a question now?', text: 'Our team is happy to help while new articles are on their way.', primary: { label: 'Contact Us', href: '/contact' }, secondary: { label: 'FAQs', href: '/resources/faqs' } },
];
---
<InfoPage slug="blog" name="Educational Articles" group="Resources" groupHref="/resources" title="Educational Articles" eyebrow="Resources · Bedminster, NJ" interest="not-sure"
  seoTitle="Educational Articles | AgeWell Medicine & Aesthetics, Bedminster NJ"
  seoDescription="Plain-language articles on healthy aging, hormone care, hair restoration and aesthetics from AgeWell Medicine & Aesthetics."
  intro="Plain-language reading on healthy aging, hair and aesthetics from our team."
  heroImage={hero('blog-hero', 'A woman smiling at her laptop while working at a bright desk', 1400, 935)} heroChip="Learn"
  blocks={blocks} />
