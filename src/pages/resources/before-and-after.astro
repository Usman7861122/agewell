---
import InfoPage from '../../components/sections/InfoPage.astro';
import type { Img, Block } from '../../lib/info-types';
import { site } from '../../lib/site';

// Fresh Unsplash photos (free licence), used only on this page. Saved in /public/images/pages.
const hero = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, srcset: `/images/pages/${n}-640.jpg 640w, /images/pages/${n}.jpg 1400w`, alt, w, h });
const body = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, alt, w, h });
// The practice's own results photos (from the live site, used with the owner's permission). Each image shows before on the left and after on the right.
const results = Array.from({ length: 22 }, (_, i) => ({ src: `/images/before-after/ba-${i + 1}.jpg`, alt: `Hair restoration result ${i + 1}: before on the left, after on the right` }));
const blocks: Block[] = [
  { type: 'split', eyebrow: 'Hair restoration', heading: 'Real goals, gentle approach', paragraphs: ['Our non-surgical approach to hair restoration is designed to support natural growth, add density and help you feel more confident.', 'Results are personal and vary from person to person. A consultation helps us explain what may be possible for you.'], image: body('before-after-body', 'A smiling woman running her hands through long, healthy hair', 1400, 933), bullets: ['Non-surgical options', 'Plans made for you', 'Honest talk about what to expect'], cta: { label: 'Hair Restoration', href: '/hair-restoration' } },
  { type: 'gallery', eyebrow: 'Results', heading: 'Before and after', intro: 'Before is on the left and after is on the right. Individual results vary.', ratio: 'wide', items: results },
  { type: 'cards', eyebrow: 'Good to know', heading: 'About these results', tone: 'white', items: [
    { title: 'Results vary', body: 'Each person responds differently. Photos are not a promise of your results.' },
    { title: 'Consultation first', body: 'Your clinician reviews your hair and history before suggesting any option.' },
    { title: 'Ask to see more', body: 'Ask our team about results at your consultation.' },
  ] },
  { type: 'band', heading: 'Curious about your hair?', text: 'Request a consultation and we will look at your options with you.', primary: { label: 'Request Consultation', href: '/#consultation' } },
];
// TODO: practice to confirm patient consent and the full-size originals (these are 500px wide).
---
<InfoPage slug="resources/before-and-after" name="Before and After" group="Resources" groupHref="/resources" title="Before and After" eyebrow="Resources · Bedminster, NJ" interest="not-sure"
  seoTitle="Before and After | AgeWell Medicine & Aesthetics, Bedminster NJ"
  seoDescription="Before and after hair restoration results from AgeWell Medicine & Aesthetics in Bedminster, NJ. Individual results vary."
  intro="A look at non-surgical hair restoration results. Every person is different."
  blocks={blocks} />
