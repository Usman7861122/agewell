---
import InfoPage from '../../components/sections/InfoPage.astro';
import type { Img, Block } from '../../lib/info-types';
import { site } from '../../lib/site';

// Fresh Unsplash photos (free licence), used only on this page. Saved in /public/images/pages.
const hero = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, srcset: `/images/pages/${n}-640.jpg 640w, /images/pages/${n}.jpg 1400w`, alt, w, h });
const body = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, alt, w, h });
const blocks: Block[] = [
  { type: 'split', eyebrow: 'Payment options', heading: 'Care that fits your budget', paragraphs: ['Financing options are available, including Cherry and CareCredit. Ask our team about options for your care.', 'Approval and terms depend on the financing provider. Our team can explain how each option works so you can choose with confidence.'], image: body('financing-body', 'A person using a calculator at a desk', 1400, 933), bullets: ['Cherry', 'CareCredit', 'Ask us about options for your plan'] },
  { type: 'steps', eyebrow: 'How it works', heading: 'Simple steps to pay over time', items: [
    { title: 'Plan', body: 'Meet your provider and agree on your care plan.' },
    { title: 'Ask', body: 'Talk with our team about financing options.' },
    { title: 'Apply', body: 'Apply with the financing provider you prefer.' },
    { title: 'Begin', body: 'Start care once you are ready.' },
  ] },
  { type: 'faq', eyebrow: 'Questions', heading: 'Financing FAQs', items: [
    { q: 'Which financing options do you accept?', a: 'Financing options are available, including Cherry and CareCredit.' },
    { q: 'Will I be approved?', a: 'Approval and terms depend on the financing provider. We cannot guarantee approval.' },
    { q: 'Does applying affect my credit?', a: 'Please ask the financing provider about how applying works and how it may affect your credit.' },
    { q: 'What does my care cost?', a: 'Pricing depends on your plan. Please contact our team.' },
  ] },
];
// TODO: practice to confirm financing partners, links and wording with Cherry and CareCredit.
---
<InfoPage slug="resources/financing" name="Financing" group="Resources" groupHref="/resources" title="Financing" eyebrow="Resources · Bedminster, NJ" interest="not-sure"
  seoTitle="Financing | AgeWell Medicine & Aesthetics, Bedminster NJ"
  seoDescription="Financing options at AgeWell Medicine & Aesthetics in Bedminster, NJ, including Cherry and CareCredit. Approval and terms depend on the provider."
  intro="Financing options are available, including Cherry and CareCredit. Ask our team how they work."
  heroImage={hero('financing-hero', 'A hand holding a phone showing a calculator over paperwork', 1400, 933)} heroChip="Flexible payment"
  blocks={blocks} />
