---
import InfoPage from '../../components/sections/InfoPage.astro';
import type { Img, Block } from '../../lib/info-types';
import { site } from '../../lib/site';

// Fresh Unsplash photos (free licence), used only on this page. Saved in /public/images/pages.
const hero = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, srcset: `/images/pages/${n}-640.jpg 640w, /images/pages/${n}.jpg 1400w`, alt, w, h });
const body = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, alt, w, h });
const g = 'https://www.google.com/maps/search/AgeWell+Medicine+%26+Aesthetics+Bedminster+NJ';
const blocks: Block[] = [
  { type: 'split', eyebrow: 'We are listening', heading: 'Your voice matters', paragraphs: ['We want every visit to feel welcoming and clear. If something went well, we would love to hear it. If something could be better, please tell us.', 'You can share feedback with our team directly, or leave a public review.'], image: body('feedback-body', 'A hand holding a handwritten thank you note', 1400, 1750), flip: true },
  { type: 'cards', eyebrow: 'Ways to share', heading: 'Choose what is easiest for you', tone: 'white', items: [
    { title: 'Message our team', body: 'Send us a note about your visit.', href: '/contact' },
    { title: 'Call us', body: 'Speak with our team at ' + site.phone + '.', href: site.phoneHref },
    { title: 'Leave a Google review', body: 'Help other patients find the right care.', href: g },
  ] },
];
// TODO: practice to confirm its private feedback form link (the live site links to an external form).
---
<InfoPage slug="resources/feedback" name="Feedback" group="Resources" groupHref="/resources" title="Feedback" eyebrow="Resources · Bedminster, NJ" interest="not-sure"
  seoTitle="Feedback | AgeWell Medicine & Aesthetics, Bedminster NJ"
  seoDescription="Share feedback about your visit to AgeWell Medicine & Aesthetics in Bedminster, NJ."
  intro="Tell us how we did. Your feedback helps us care for you better."
  blocks={blocks} medical={false} />
