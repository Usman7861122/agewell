---
import InfoPage from '../../components/sections/InfoPage.astro';
import type { Img, Block } from '../../lib/info-types';
import { site } from '../../lib/site';

// Fresh Unsplash photos (free licence), used only on this page. Saved in /public/images/pages.
const hero = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, srcset: `/images/pages/${n}-640.jpg 640w, /images/pages/${n}.jpg 1400w`, alt, w, h });
const body = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, alt, w, h });
const q = (s: string) => 'https://www.google.com/maps/search/' + encodeURIComponent(s + ' near Bedminster NJ');
const blocks: Block[] = [
  { type: 'split', eyebrow: 'Around Bedminster', heading: 'A friendly place to visit', paragraphs: ['Bedminster is a small township in Somerset County, New Jersey. If you are visiting from out of town, these links can help you plan your day.'], image: body('local-body', 'A brick building among golden autumn trees along a quiet road', 1400, 788), flip: true },
  { type: 'cards', eyebrow: 'Quick links', heading: 'Find what you need nearby', tone: 'white', items: [
    { title: 'Township website', body: 'The official website of Bedminster Township.', href: 'https://www.bedminster.us' },
    { title: 'Hospitals', body: 'See hospitals near Bedminster on a map.', href: q('hospitals') },
    { title: 'Public parks', body: 'Find parks and green spaces nearby.', href: q('public parks') },
    { title: 'High schools', body: 'See high schools in the area.', href: q('high schools') },
    { title: 'Banks', body: 'Find banks close to our office.', href: q('banks') },
    { title: 'Get directions', body: 'Plan your trip to our office.', href: q('AgeWell Medicine & Aesthetics, 2436 Lamington Rd Suite 1') },
  ] },
  { type: 'band', heading: 'Planning a visit?', text: 'Our team is happy to help with directions and questions.', primary: { label: 'Contact Us', href: '/contact' } },
];
// TODO: confirm the township website address.
---
<InfoPage slug="resources/local-resources" name="Local Resources" group="Resources" groupHref="/resources" title="Local Resources" eyebrow="Resources · Bedminster, NJ" interest="not-sure"
  seoTitle="Local Resources | AgeWell Medicine & Aesthetics, Bedminster NJ"
  seoDescription="Helpful local links for patients visiting AgeWell Medicine & Aesthetics in Bedminster, NJ: township website, hospitals, parks, schools and banks."
  intro="Helpful links for life in and around Bedminster."
  blocks={blocks} medical={false} />
