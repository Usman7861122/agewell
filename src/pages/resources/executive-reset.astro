---
import InfoPage from '../../components/sections/InfoPage.astro';
import type { Img, Block } from '../../lib/info-types';
import { site } from '../../lib/site';

// Fresh Unsplash photos (free licence), used only on this page. Saved in /public/images/pages.
const hero = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, srcset: `/images/pages/${n}-640.jpg 640w, /images/pages/${n}.jpg 1400w`, alt, w, h });
const body = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, alt, w, h });
const blocks: Block[] = [
  { type: 'split', eyebrow: 'The program', heading: 'One plan, built around you', paragraphs: ['The Executive Reset is an anti-aging and wellness program led by Dr. Frank Dos Santos. It is a physician-supervised, concierge approach that is part of our longevity and functional medicine care.', 'It brings four parts together into a single plan that is customized to you.'], image: body('executive-reset-body', 'A professional in a business suit meditating on a bed beside a laptop', 1400, 788), bullets: ['Physician-supervised', 'Personalized to you', 'One clear plan, not four separate ones'], cta: { label: 'Request Information', href: '/contact' } },
  { type: 'cards', eyebrow: 'What is included', heading: 'Four parts, one protocol', items: [
    { title: 'Hormone optimization', body: 'Bioidentical hormone care, when appropriate, based on your history, symptoms and testing.' },
    { title: 'Peptide therapy', body: 'Evidence-based peptide therapy, when appropriate for you.' },
    { title: 'Biomarker testing', body: 'Advanced testing that helps your clinician understand your health and guide the plan.' },
    { title: 'Mindset coaching', body: 'Executive-level mindset coaching to support habits, focus and stress.' },
  ] },
  { type: 'steps', eyebrow: 'How it works', heading: 'Getting started', items: [
    { title: 'Ask', body: 'Request information or call our office.' },
    { title: 'Meet', body: 'Talk with your provider about your goals and history.' },
    { title: 'Plan', body: 'Agree on a protocol that fits you, including benefits, risks and alternatives.' },
    { title: 'Follow up', body: 'Regular check-ins to review how you feel and adjust the plan.' },
  ] },
  { type: 'band', heading: 'Interested in the Executive Reset?', text: 'Ask for the program details and we will walk you through them.', primary: { label: 'Request Consultation', href: '/#consultation' } },
];
// TODO: practice to supply program length, pricing approach and the informational PDF. Provider to review clinical wording.
---
<InfoPage slug="resources/executive-reset" name="Executive Reset" group="Resources" groupHref="/resources" title="Executive Reset" eyebrow="Resources · Bedminster, NJ" interest="not-sure"
  seoTitle="Executive Reset | AgeWell Medicine & Aesthetics, Bedminster NJ"
  seoDescription="The Executive Reset is a physician-supervised concierge wellness program at AgeWell Medicine & Aesthetics in Bedminster, NJ, led by Dr. Frank Dos Santos."
  intro="A physician-supervised concierge program for busy leaders who want a personal plan for how they feel and perform."
  blocks={blocks} />
