---
import InfoPage from '../../components/sections/InfoPage.astro';
import type { Img, Block } from '../../lib/info-types';
import { site } from '../../lib/site';

// Fresh Unsplash photos (free licence), used only on this page. Saved in /public/images/pages.
const hero = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, srcset: `/images/pages/${n}-640.jpg 640w, /images/pages/${n}.jpg 1400w`, alt, w, h });
const body = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, alt, w, h });
const blocks: Block[] = [
  { type: 'split', eyebrow: 'Learn at your pace', heading: 'Information you can trust', paragraphs: ['Our library brings together simple guides about healthy aging, hair restoration and aesthetic care.', 'Reading is a good way to prepare for a visit. It does not replace advice from your own clinician.'], image: body('library-body', 'Tall bookshelves in a quiet library lit by hanging bulbs', 1400, 1294), flip: true },
  { type: 'cards', eyebrow: 'Where to start', heading: 'Helpful places to read', tone: 'white', items: [
    { title: 'Educational Articles', body: 'Plain-language articles from our team.', href: '/blog' },
    { title: 'FAQs', body: 'Quick answers to common questions.', href: '/resources/faqs' },
    { title: 'Our care', body: 'Read about longevity medicine, hair restoration and aesthetics.', href: '/longevity' },
  ] },
  { type: 'band', heading: 'Cannot find what you need?', text: 'Ask our team and we will point you in the right direction.', primary: { label: 'Contact Us', href: '/contact' } },
];
// TODO: practice to supply the patient-education library link or documents (the live site links to an external app).
---
<InfoPage slug="resources/library" name="Library" group="Resources" groupHref="/resources" title="Library" eyebrow="Resources · Bedminster, NJ" interest="not-sure"
  seoTitle="Library | AgeWell Medicine & Aesthetics, Bedminster NJ"
  seoDescription="Patient education library from AgeWell Medicine & Aesthetics in Bedminster, NJ. Plain-language reading and answers."
  intro="Plain-language reading to help you understand your care."
  blocks={blocks} />
