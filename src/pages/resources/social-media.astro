---
import InfoPage from '../../components/sections/InfoPage.astro';
import type { Img, Block } from '../../lib/info-types';
import { site } from '../../lib/site';

// Fresh Unsplash photos (free licence), used only on this page. Saved in /public/images/pages.
const hero = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, srcset: `/images/pages/${n}-640.jpg 640w, /images/pages/${n}.jpg 1400w`, alt, w, h });
const body = (n: string, alt: string, w: number, h: number): Img => ({ src: `/images/pages/${n}.jpg`, alt, w, h });
const blocks: Block[] = [
  { type: 'split', eyebrow: 'Stay connected', heading: 'Find us online', paragraphs: ['Follow AgeWell on social media for updates from our Bedminster office, and read what patients say about us.'], image: body('social-body', 'A person scrolling on a smartphone', 1400, 933) },
  { type: 'cards', eyebrow: 'Our profiles', heading: 'Where to find us', tone: 'white', items: site.social.map((s) => ({ title: s.label, body: 'Visit our ' + s.label + ' page.', href: s.href })) },
  { type: 'band', heading: 'Rather talk to a person?', text: 'Call or message our team any time during office hours.', primary: { label: 'Contact Us', href: '/contact' } },
];
---
<InfoPage slug="resources/social-media" name="Social Media" group="Resources" groupHref="/resources" title="Social Media" eyebrow="Resources · Bedminster, NJ" interest="not-sure"
  seoTitle="Social Media | AgeWell Medicine & Aesthetics, Bedminster NJ"
  seoDescription="Follow AgeWell Medicine & Aesthetics on Facebook, Instagram, Yelp and Google."
  intro="Follow along for news, tips and a look behind the scenes."
  blocks={blocks} medical={false} />
