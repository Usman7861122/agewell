---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../lib/site';
const links = [
  { label: 'Longevity Medicine', href: '/longevity' },
  { label: 'Hair Restoration', href: '/hair-restoration' },
  { label: 'Aesthetics', href: '/aesthetics' },
  { label: 'Our Providers', href: '/providers' },
  { label: 'Contact', href: '/contact' },
];
---
<BaseLayout title="Page not found | AgeWell Medicine & Aesthetics" description="This page could not be found.">
  <section class="nf depth-dark on-dark">
    <Container>
      <div class="nf-in">
        <p class="eyebrow nf-eyebrow">Error 404</p>
        <h1 class="h-display nf-h1">We could not find that page</h1>
        <p class="nf-p">The page may have moved. Try one of these, or call us at <a href={site.phoneHref}>{site.phone}</a>.</p>
        <ul class="nf-links">{links.map((l) => <li><a href={l.href}>{l.label}<span aria-hidden="true">→</span></a></li>)}</ul>
        <div class="nf-cta"><Button href="/">Back Home</Button></div>
      </div>
    </Container>
  </section>
</BaseLayout>
<style>
  .nf { position: relative; isolation: isolate; overflow: hidden; background: #16321f; color: #fff; padding-block: clamp(5rem, 12vw, 9rem); text-align: center; }
  .nf-in { max-width: 40rem; margin: 0 auto; }
  .nf-eyebrow { color: #9fcdac; }
  .nf-h1 { margin-top: 1rem; font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.1; }
  .nf-p { margin-top: 1.25rem; font-size: 1.125rem; color: rgb(255 255 255 / .85); }
  .nf-p a { text-decoration: underline; text-underline-offset: 4px; }
  .nf-links { margin-top: 2.25rem; display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; list-style: none; padding: 0; }
  .nf-links a { display: inline-flex; gap: .5rem; padding: .7rem 1.25rem; border-radius: 9999px; background: rgb(255 255 255 / .07); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .15); font-weight: 600; transition: background-color .25s, transform .25s; }
  .nf-links a:hover { background: rgb(159 205 172 / .2); transform: translateY(-2px); }
  .nf-cta { margin-top: 2.5rem; }
</style>
