---
import { site, book } from '../../lib/site';
---
<!-- Always-visible booking + tap-to-call on phones and tablets (hidden when the full desktop nav shows) -->
<div class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-white/95 px-4 py-2.5 backdrop-blur min-[1400px]:hidden" style="padding-bottom:max(.625rem, env(safe-area-inset-bottom))">
  <div class="mx-auto flex max-w-xl gap-3">
    <a href={book()} class="btn btn-primary flex-1 !px-3" aria-label="Request a consultation">Consultation</a>
    <a href={site.phoneHref} class="btn btn-dark !px-4" aria-label={`Call ${site.phone}`}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
      <span class="sr-only sm:not-sr-only">Call</span>
    </a>
  </div>
</div>
