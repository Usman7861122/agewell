---
import { site } from '../../lib/site';
const year = new Date().getFullYear();
const groups = [
  { title: 'Longevity', links: [
    { label: 'Evaluation', href: '/longevity/evaluation' },
    { label: 'Metabolic Health', href: '/longevity/metabolic-health' },
    { label: 'Hormone Care', href: '/longevity/hormone-care' },
    { label: 'Functional Medicine', href: '/longevity/functional-medicine' },
  ]},
  { title: 'Care', links: [
    { label: 'Hair Restoration', href: '/hair-restoration' },
    { label: 'Aesthetics', href: '/aesthetics' },
    { label: 'Our Providers', href: '/providers' },
    { label: 'Store', href: '/store' },
    { label: 'About', href: '/about' },
  ]},
  { title: 'Resources', links: [
    { label: 'New Patients', href: '/resources/new-patients' },
    { label: 'Virtual Visits', href: '/resources/virtual-visits' },
    { label: 'FAQs', href: '/resources/faqs' },
    { label: 'Financing', href: '/resources/financing' },
    { label: 'Reviews', href: '/reviews' },
    { label: 'All resources →', href: '/resources' },
  ]},
];
const directions = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${site.address.street}, ${site.address.city}, ${site.address.region} ${site.address.zip}`)}`;
---
<footer class="ft depth-dark on-dark">
  <div class="ft-in">
    <div class="ft-grid">
      <div class="ft-brand">
        <a href="/" class="ft-logo" aria-label="AgeWell Medicine & Aesthetics, home"><img src="/images/logo.png" alt="AgeWell Medicine & Aesthetics" width="189" height="100" loading="lazy" /></a>
        <p>Physician-led longevity medicine in Bedminster, NJ, with non-surgical hair restoration and aesthetics.</p>
        <ul class="ft-social">{site.social.map((s) => <li><a href={s.href} rel="noopener" target="_blank">{s.label}</a></li>)}</ul>
      </div>
      {groups.map((g) => (
        <nav aria-label={g.title} class="ft-col">
          <h2>{g.title}</h2>
          <ul>{g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      ))}
      <div class="ft-col ft-contact">
        <h2>Get in touch</h2>
        <address>
          <a class="ft-phone" href={site.phoneHref}>{site.phone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <span>{site.address.street}, {site.address.city}, {site.address.region} {site.address.zip}</span>
          <a class="ft-dir" href={directions} target="_blank" rel="noopener">Get directions →</a>
        </address>
      </div>
    </div>
    <div class="ft-bar">
      <p>© {year} {site.name}</p>
      <p class="ft-hours">{site.hours}</p>
      <ul>
        <li><a href="/privacy-policy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
      </ul>
    </div>
  </div>
</footer>
<style>
  .ft { position: relative; isolation: isolate; background: #1b1514; color: #fff; }
  .ft-in { max-width: 80rem; margin: 0 auto; padding: 3rem 1rem 1.25rem; }
  @media (min-width: 640px) { .ft-in { padding-inline: 1.5rem; } }
  @media (min-width: 1024px) { .ft-in { padding-inline: 2rem; } }
  .ft-grid { display: grid; gap: 2rem 1.5rem; grid-template-columns: repeat(2, 1fr); }
  .ft-brand { grid-column: 1 / -1; }
  @media (min-width: 1024px) { .ft-grid { grid-template-columns: 1.4fr .9fr .8fr .9fr 1.4fr; gap: 2rem; } .ft-brand { grid-column: auto; } }
  .ft-logo { display: inline-block; padding: .4rem; border-radius: .6rem; background: #fff; }
  .ft-logo img { display: block; height: 2.5rem; width: auto; }
  .ft-brand p { margin-top: 1rem; max-width: 20rem; font-size: .875rem; line-height: 1.6; color: rgb(255 255 255 / .7); }
  .ft-social { display: flex; flex-wrap: wrap; gap: .25rem 1rem; margin-top: .75rem; padding: 0; list-style: none; font-size: .8125rem; }
  .ft-social a { display: inline-block; padding: .35rem 0; color: rgb(255 255 255 / .85); }
  .ft h2 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: .8125rem; letter-spacing: .2em; text-transform: uppercase; color: #9fcdac; }
  .ft-col ul { margin: .75rem 0 0; padding: 0; list-style: none; }
  .ft-col li a { display: inline-block; padding: .22rem 0; font-size: .875rem; color: rgb(255 255 255 / .75); }
  .ft a { text-underline-offset: 4px; transition: color .2s; }
  .ft a:hover { color: #fff; text-decoration: underline; }
  .ft-contact { grid-column: 1 / -1; }
  @media (min-width: 1024px) { .ft-contact { grid-column: auto; } }
  .ft-contact address { margin-top: .75rem; display: flex; flex-direction: column; gap: .35rem; font-style: normal; font-size: .875rem; line-height: 1.5; color: rgb(255 255 255 / .75); }
  .ft-phone { font-weight: 600; color: #fff; font-size: .9375rem; }
  .ft-dir { color: #9fcdac; font-weight: 600; }
  .ft-bar { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid rgb(255 255 255 / .12); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 1.5rem; font-size: .75rem; color: rgb(255 255 255 / .55); }
  .ft-hours { flex: 1 1 18rem; }
  .ft-bar ul { display: flex; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .ft-bar ul a { display: inline-block; padding: .25rem 0; }
</style>
