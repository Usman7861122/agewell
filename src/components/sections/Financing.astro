---
import Container from '../ui/Container.astro';
---
<section class="bg-white py-12" aria-labelledby="fin-title">
  <Container narrow>
    <div class="rounded-2xl border border-line p-7 text-center sm:p-9">
      <h2 id="fin-title" class="font-display text-2xl uppercase tracking-wide">Financing options</h2>
      <p class="mt-3 text-lg">Financing options are available, including Cherry and CareCredit. Ask our team about options for your care. Approval and terms depend on the financing provider.</p>
      <a href="/resources/financing" class="link-arrow mt-2" aria-label="Explore financing options">Learn More <span aria-hidden="true">→</span></a>
    </div>
  </Container>
</section>
