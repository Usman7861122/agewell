---
// Contact form from the practice's booking system (embedded iframe). Replaces the old built-in form.
---
<div class="ce-card">
  <iframe
    src="https://link.aestheticrecord.com/widget/form/9eLLRvn2kVtULe9EX57u"
    style="width:100%;height:730px;border:none;border-radius:8px"
    id="inline-9eLLRvn2kVtULe9EX57u"
    data-layout="{'id':'INLINE'}"
    data-trigger-type="alwaysShow"
    data-trigger-value=""
    data-activation-type="alwaysActivated"
    data-activation-value=""
    data-deactivation-type="neverDeactivate"
    data-deactivation-value=""
    data-form-name="Website Contact Us Form "
    data-height="730"
    data-layout-iframe-id="inline-9eLLRvn2kVtULe9EX57u"
    data-form-id="9eLLRvn2kVtULe9EX57u"
    data-cookie-consent="true"
    data-cookie-consent-provider="auto"
    title="Website Contact Us Form "
    loading="lazy"
  ></iframe>
</div>
<script is:inline src="https://link.aestheticrecord.com/js/form_embed.js"></script>

<style>
  .ce-card { border-radius: 1.25rem; background: #fff; padding: .75rem; box-shadow: 0 30px 60px -36px rgb(0 0 0 / .5); }
</style>
