---
import PillarsTimeline from '../../islands/interactive/PillarsTimeline';
---
<section class="depth-dark relative isolate overflow-hidden bg-deep py-20 text-white on-dark md:py-28" aria-labelledby="pillars-title">
  <!-- soft decorative shape, like the reference -->
  <div class="pointer-events-none absolute -left-32 top-24 -z-10 h-[540px] w-[540px] rounded-full bg-white/[0.035]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-40 bottom-10 -z-10 h-[460px] w-[460px] rounded-full bg-white/[0.025]" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow text-[13px] text-leaf">Our five pillars</p>
      <h2 id="pillars-title" class="h-display mt-5 text-4xl sm:text-5xl lg:text-6xl">A connected approach to healthy aging</h2>
      <p class="mt-6 text-lg text-white/75">We consider five areas that can shape your health and daily function. Your evaluation and care plan are tailored to your needs.</p>
    </div>
    <PillarsTimeline client:visible />
  </div>
</section>
