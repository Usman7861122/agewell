---
interface Props { id?: string; tone?: 'white' | 'mist' | 'dark' | 'brand'; class?: string; labelledby?: string }
const { id, tone = 'white', class: cls = '', labelledby } = Astro.props;
const tones = { white: 'bg-white text-ink', mist: 'bg-mist text-ink', dark: 'bg-ink text-white on-dark', brand: 'bg-brand text-white on-dark' };
---
<section id={id} aria-labelledby={labelledby} class:list={['py-16 md:py-24', tones[tone], cls]}><slot /></section>
