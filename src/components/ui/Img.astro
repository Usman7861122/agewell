---
import { photos, src, srcset, type PhotoKey } from '../../lib/images';
interface Props { name: PhotoKey; sizes?: string; class?: string; eager?: boolean; w?: number; h?: number; decorative?: boolean }
const { name, sizes = '100vw', class: cls = '', eager = false, w = 1600, h = 1067, decorative = false } = Astro.props;
const widths = [480, 768, 1080, 1600];
---
<img src={src(name, 1080)} srcset={srcset(name, widths)} sizes={sizes} alt={decorative ? '' : photos[name].alt}
  width={w} height={h} class={cls} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
