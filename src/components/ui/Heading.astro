---
interface Props { as?: 'h1' | 'h2' | 'h3'; id?: string; eyebrow?: string; center?: boolean; class?: string; size?: 'xl' | 'lg' | 'md' }
const { as: Tag = 'h2', id, eyebrow, center = false, class: cls = '', size = 'lg' } = Astro.props;
const sizes = { xl: 'text-4xl sm:text-5xl lg:text-6xl', lg: 'text-3xl sm:text-4xl lg:text-5xl', md: 'text-2xl sm:text-3xl' };
---
<div class:list={[center && 'text-center', cls]}>
  {eyebrow && <p class="eyebrow mb-4 opacity-90">{eyebrow}</p>}
  <Tag id={id} class:list={['h-display', sizes[size]]}><slot /></Tag>
</div>
